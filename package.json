{
  "name": "minilist",
  "version": "1.0.0",
  "private": true,
  "description": "minilist —— 把选中的 HTML 投放到局域网端口，并展示指定文件夹的文件；支持上传/下载/修改，登录后可写，未登录只读。纯黑白界面，零第三方依赖。",
  "main": "src/launch.js",
  "bin": {
    "minilist": "src/launch.js"
  },
  "scripts": {
    "start": "node src/launch.js",
    "test": "node test/selftest.js",
    "build:exe": "node tools/build-exe.js"
  },
  "pkg": {
    "assets": [
      "public/**/*"
    ],
    "targets": [
      "node20-win-x64"
    ],
    "outputPath": "dist"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "keywords": [
    "lan",
    "file-server",
    "file-browser",
    "html",
    "publish",
    "readonly",
    "login",
    "no-dependencies",
